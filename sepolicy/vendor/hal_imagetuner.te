type hal_imagetuner_default, domain;
type hal_imagetuner_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_imagetuner_default)

hal_server_domain(hal_imagetuner_default, hal_imagetuner)
add_hwservice(hal_imagetuner_server, hal_imagetuner_hwservice)
binder_call(hal_imagetuner_client, hal_imagetuner_server)
allow hal_imagetuner_client hal_imagetuner_hwservice:hwservice_manager find;
allow hal_imagetuner_default hidl_memory_hwservice:hwservice_manager find;

allow hal_imagetuner_default hal_allocator:fd use;
allow hal_imagetuner_server vendor_camera_data_file:dir create_dir_perms;
allow hal_imagetuner_server vendor_camera_data_file:file create_file_perms;
